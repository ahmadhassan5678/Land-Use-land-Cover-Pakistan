# Esri global Sentinel-2 10m Land Cover ImageServer
ESRI_LANDCOVER_IMAGE_SERVER_URL=https://ic.imagery1.arcgis.com/arcgis/rest/services/Sentinel2_10m_LandCover/ImageServer

# Optional but required for automatic OpenTopography COP30 elevation download.
# Obtain an API key from https://opentopography.org/
OPENTOPOGRAPHY_API_KEY=PUT_YOUR_API_KEY_HERE

# GADM administrative level 2 boundary GeoPackage (not an official government boundary source)
GADM_PAK_GPKG_URL=https://geodata.ucdavis.edu/gadm/gadm4.1/gpkg/gadm41_PAK.gpkg

MAX_UPLOAD_MB=100
HOST=127.0.0.1
PORT=5000
